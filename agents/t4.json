{
  "_ten": {
    "predefined_graphs": [
      {
        "name": "va_openai_tencent",
        "auto_start": true,
        "nodes": [
          {
            "type": "extension",
            "name": "agora_rtc",
            "addon": "agora_rtc",
            "extension_group": "default",
            "property": {
              "app_id": "${env:AGORA_APP_ID}",
              "token": "${env:AGORA_APP_ID}",
              "channel": "ten_agent_order123",
              "stream_id": 1234,
              "remote_stream_id": 123,
              "subscribe_audio": true,
              "subscribe_audio_sample_rate": 16000,
              "subscribe_audio_num_of_channels": 1,
              "subscribe_audio_samples_per_frame": 640,
              "publish_audio": true,
              "publish_data": true,
              "enable_agora_asr": false,
              "agora_asr_session_control_file_path": "session_control.conf"
            }
          },
          {
            "type": "extension",
            "name": "stt",
            "addon": "tencent_asr_python",
            "extension_group": "stt",
            "property": {
              "model": "16k_en"
            }
          },
          {
            "type": "extension",
            "name": "order_agent",
            "addon": "agent_python",
            "extension_group": "agent",
            "property": {
              "llm1_key": "${env:OPENAI_API_KEY}",
              "llm1_url": "${env:OPENAI_API_BASE}",
              "llm1_model": "${env:OPENAI_MODEL}",
              "llm1_prompt": "",
              "greeting": "Agent connected. How can I help you today?",
              "max_memory_length": 10,
              "max_tokens": 512
            }
          },
          {
            "type": "extension",
            "name": "tts",
            "addon": "tencent_tts_python",
            "extension_group": "tts",
            "property": {
              "voice_id": 101051
            }
          },
          {
            "type": "extension",
            "name": "interrupt_detector",
            "addon": "interrupt_detector_python",
            "extension_group": "default",
            "property": {}
          },
          {
            "type": "extension",
            "name": "message_collector",
            "addon": "message_collector",
            "extension_group": "transcriber",
            "property": {}
          }
        ],
        "connections": [
          {
            "extension": "agora_rtc",
            "cmd": [
              {
                "name": "on_user_joined",
                "dest": [
                  {
                    "extension": "stt"
                  },
                  {
                    "extension": "order_agent"
                  },
                  {
                    "extension": "tts"
                  }
                ]
              },
              {
                "name": "on_user_left",
                "dest": [
                  {
                    "extension": "stt"
                  },
                  {
                    "extension": "order_agent"
                  },
                  {
                    "extension": "tts"
                  }
                ]
              }
            ],
            "audio_frame": [
              {
                "name": "pcm_frame",
                "dest": [
                  {
                    "extension": "stt"
                  }
                ]
              }
            ],
            "data": [
              {
                "name": "text_data",
                "dest": [
                  {
                    "extension": "message_collector"
                  }
                ]
              }
            ]
          },
          {
            "extension": "stt",
            "data": [
              {
                "name": "text_data",
                "dest": [
                  {
                    "extension": "interrupt_detector"
                  },
                  {
                    "extension": "message_collector"
                  }
                ]
              }
            ]
          },
          {
            "extension": "order_agent",
            "cmd": [
              {
                "name": "flush",
                "dest": [
                  {
                    "extension": "tts"
                  }
                ]
              }
            ],
            "data": [
              {
                "name": "text_data",
                "dest": [
                  {
                    "extension": "tts"
                  },
                  {
                    "extension": "message_collector"
                  }
                ]
              }
            ]
          },
          {
            "extension": "message_collector",
            "data": [
              {
                "name": "data",
                "dest": [
                  {
                    "extension": "agora_rtc"
                  }
                ]
              }
            ]
          },
          {
            "extension": "tts",
            "cmd": [
              {
                "name": "flush",
                "dest": [
                  {
                    "extension": "agora_rtc"
                  }
                ]
              }
            ],
            "audio_frame": [
              {
                "name": "pcm_frame",
                "dest": [
                  {
                    "extension": "agora_rtc"
                  }
                ]
              }
            ]
          },
          {
            "extension": "interrupt_detector",
            "cmd": [
              {
                "name": "flush",
                "dest": [
                  {
                    "extension": "order_agent"
                  }
                ]
              }
            ],
            "data": [
              {
                "name": "text_data",
                "dest": [
                  {
                    "extension": "order_agent"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "log_level": 3
  }
}