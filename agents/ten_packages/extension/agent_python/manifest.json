{
  "type": "extension",
  "name": "agent_python",
  "version": "0.1.0",
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.8"
    }
  ],
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "BUILD.gn",
      "**.tent",
      "**.py",
      "README.md"
    ]
  },
  "api": {
    "property": {
      "llm1_key": {
        "type": "string"
      },
      "llm1_url": {
        "type": "string"
      },
      "llm1_model": {
        "type": "string"
      },
      "llm1_prompt": {
        "type": "string"
      },
      "llm2_key": {
        "type": "string"
      },
      "llm2_url": {
        "type": "string"
      },
      "llm2_model": {
        "type": "string"
      },
      "llm2_prompt": {
        "type": "string"
      },
      "max_tokens": {
        "type": "int64"
      },
      "greeting": {
        "type": "string"
      },
      "max_memory_length": {
        "type": "int64"
      }
    },
    "data_in": [
      {
        "name": "text_data",
        "property": {
          "text": {
            "type": "string"
          }
        }
      }
    ],
    "data_out": [
      {
        "name": "text_data",
        "property": {
          "text": {
            "type": "string"
          }
        }
      }
    ],
    "cmd_in": [
      {
        "name": "flush"
      },
      {
        "name": "on_user_joined",
        "property": {}
      },
      {
        "name": "on_user_left",
        "property": {}
      },
      {
        "name": "tool_register",
        "property": {
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {}
                }
              }
            },
            "required": [
              "name",
              "description",
              "parameters"
            ]
          }
        },
        "result": {
          "property": {
            "response": {
              "type": "string"
            }
          }
        }
      }
    ],
    "cmd_out": [
      {
        "name": "flush"
      },
      {
        "name": "tool_call",
        "property": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    ],
    "video_frame_in": [
      {
        "name": "video_frame"
      }
    ]
  }
}